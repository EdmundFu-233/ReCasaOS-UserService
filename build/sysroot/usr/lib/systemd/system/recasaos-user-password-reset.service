[Unit]
Description=ReCasaOS local administrator password reset
Conflicts=casaos-user-service.service recasaos-user-bootstrap.service
Before=casaos-user-service.service

[Service]
Type=oneshot
LoadCredential=recasaos.admin.username:/run/recasaos-user-password-reset/username
LoadCredential=recasaos.admin.new-password:/run/recasaos-user-password-reset/new-password
ExecStart=/usr/bin/casaos-user-service reset-admin-password -c /etc/casaos/user-service.conf
ExecStopPost=-/usr/bin/rm -f -- /run/recasaos-user-password-reset/username /run/recasaos-user-password-reset/new-password
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

# This unit is intentionally not enabled. An administrator must explicitly
# supply both credentials through systemd and start it locally.
