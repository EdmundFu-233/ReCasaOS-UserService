[Unit]
Description=ReCasaOS local non-administrator password reset
Conflicts=casaos-user-service.service recasaos-user-bootstrap.service recasaos-user-password-reset.service
Before=casaos-user-service.service

[Service]
Type=oneshot
LoadCredential=recasaos.user.username:/run/recasaos-user-account-password-reset/username
LoadCredential=recasaos.user.new-password:/run/recasaos-user-account-password-reset/new-password
ExecStart=/usr/bin/casaos-user-service reset-user-password -c /etc/casaos/user-service.conf
ExecStopPost=-/usr/bin/rm -f -- /run/recasaos-user-account-password-reset/username /run/recasaos-user-account-password-reset/new-password
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

# This unit is intentionally not enabled. An operator must explicitly supply
# both credentials through systemd and start it locally. It refuses
# administrator targets without promotion.
